# ============================================================
# EduLife AI – Cấu hình môi trường
# ============================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành ".env" (xóa chữ .example)
# 2. Lấy Gemini API key MIỄN PHÍ tại:
#    https://aistudio.google.com/app/apikey
# 3. Điền key vào GEMINI_API_KEY bên dưới
# 4. KHÔNG bao giờ chia sẻ hoặc commit file .env lên GitHub!
# ============================================================

# --- Google Gemini API Key (MIỄN PHÍ) ---
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Cổng server (mặc định 3000) ---
PORT=3000

# --- Model Gemini sử dụng ---
# gemini-1.5-flash  → nhanh, miễn phí (khuyến nghị)
# gemini-1.5-pro    → mạnh hơn, vẫn có gói miễn phí
GEMINI_MODEL=gemini-1.5-flash
